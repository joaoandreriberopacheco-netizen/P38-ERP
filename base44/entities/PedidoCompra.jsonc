{
  "name": "PedidoCompra",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero do pedido (ex: PC-00001)"
    },
    "fornecedor_id": {
      "type": "string",
      "description": "ID do fornecedor"
    },
    "fornecedor_nome": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "data_emissao": {
      "type": "string",
      "format": "date",
      "description": "Data manual do pedido/compra"
    },
    "data_prevista_entrega": {
      "type": "string",
      "format": "date",
      "description": "Pr\u00f3xima ETA consolidada do pedido, calculada a partir dos embarques ativos"
    },
    "status": {
      "type": "string",
      "enum": [
        "Rascunho",
        "Aguardando Aprova\u00e7\u00e3o Financeira",
        "Aprovado"
      ],
      "default": "Rascunho",
      "description": "Status principal simplificado do pedido"
    },
    "status_embarque": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Parcial",
        "Total"
      ],
      "default": "Nenhum",
      "description": "Percentual log\u00edstico agregado do pedido com base nos embarques"
    },
    "percentual_valor_embarcado": {
      "type": "number",
      "default": 0,
      "description": "Percentual do valor total do pedido j\u00e1 coberto por embarques despachados/conclu\u00eddos"
    },
    "status_recebimento_geral": {
      "type": "string",
      "enum": [
        "Nenhum",
        "Pendente",
        "Recebido Parcial",
        "Conclu\u00eddo com Diverg\u00eancia",
        "Conclu\u00eddo OK"
      ],
      "default": "Nenhum",
      "description": "Status geral do recebimento do pedido, agregado a partir dos embarques"
    },
    "itens": {
      "type": "array",
      "description": "Lista de itens do pedido",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "unidade_medida": {
            "type": "string"
          },
          "fator_conversao": {
            "type": "number"
          },
          "quantidade_base": {
            "type": "number"
          },
          "quantidade_vinculada": {
            "type": "number",
            "default": 0
          },
          "custo_unitario": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "valor_total": {
      "type": "number"
    },
    "observacoes": {
      "type": "string"
    },
    "historico": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nfe_emitida": {
      "type": "boolean",
      "default": false
    },
    "is_encomenda": {
      "type": "boolean",
      "default": false,
      "description": "Compra encomenda (cliente). Não entra no trânsito do Resumo global de estoque."
    },
    "conta_pagamento_id": {
      "type": "string"
    },
    "tem_divergencias": {
      "type": "boolean",
      "default": false
    },
    "conferencia_id": {
      "type": "string"
    },
    "data_aprovacao_financeira": {
      "type": "string",
      "format": "date-time"
    },
    "data_despacho": {
      "type": "string",
      "format": "date-time"
    },
    "data_chegada": {
      "type": "string",
      "format": "date-time"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_rejeicao_financeira": {
      "type": "string"
    },
    "data_rejeicao_financeira": {
      "type": "string",
      "format": "date-time"
    },
    "solicitacao_cancelamento_motivo": {
      "type": "string"
    },
    "solicitacao_cancelamento_data": {
      "type": "string",
      "format": "date-time"
    },
    "solicitacao_cancelamento_solicitante": {
      "type": "string"
    },
    "solicitacao_edicao_motivo": {
      "type": "string"
    },
    "solicitacao_edicao_data": {
      "type": "string",
      "format": "date-time"
    },
    "solicitacao_edicao_solicitante": {
      "type": "string"
    },
    "aprovacao_reabertura_financeiro": {
      "type": "boolean",
      "default": false
    },
    "status_aprovacao_financeira": {
      "type": "string"
    },
    "status_conferencia_pedido": {
      "type": "string",
      "enum": [
        "N\u00e3o Iniciada",
        "Parcialmente Conferido",
        "Conferido OK",
        "Conferido com Diverg\u00eancia"
      ],
      "default": "N\u00e3o Iniciada"
    }
  },
  "required": [
    "fornecedor_id",
    "itens"
  ]
}