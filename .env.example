# Copie para .env.local (não commitar).
# No Cursor Cloud Agent / GitHub Actions, use os MESMOS nomes canónicos.
# Mapa completo: docs/migration/P38_SECRETS_CANONICOS.md
# Validação: npm run secrets:check

# --- Produção P38 (Supabase + Vercel) ---
VITE_P38_PROVIDER=supabase
VITE_P38_BYPASS_BASE44=true
VITE_P38_USE_SUPABASE_AUTH=true

# Supabase — obrigatório no Vercel e no build
VITE_SUPABASE_URL=https://zhonvxkkqabfdyehyxpu.supabase.co
VITE_SUPABASE_ANON_KEY=

# Opcional: login Google (deixar vazio se só login interno)
# VITE_P38_ENABLE_GOOGLE_LOGIN=

# --- Só scripts / CI (NUNCA prefixo VITE_, NUNCA no frontend) ---
# DATABASE_URL=postgresql://postgres.[ref]:[senha]@...pooler.supabase.com:6543/postgres
# SUPABASE_ACCESS_TOKEN=          # PAT sbp_… — https://supabase.com/dashboard/account/tokens
# SUPABASE_SERVICE_ROLE_KEY=      # service_role — só serverless/scripts
# SUPABASE_PROJECT_REF=zhonvxkkqabfdyehyxpu   # opcional se VITE_SUPABASE_URL estiver definido

# Proxy auth no Vercel (opcional — deriva de VITE_SUPABASE_URL se omitido)
# P38_AUTH_URL=https://zhonvxkkqabfdyehyxpu.supabase.co/functions/v1/p38-auth

# --- Vercel deploy (só GitHub Actions) ---
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# --- Base44 legado (só se VITE_P38_PROVIDER=base44 ou scripts de auditoria) ---
VITE_BASE44_APP_ID=
VITE_BASE44_BACKEND_URL=https://p38.base44.app
BASE44_ACCESS_TOKEN=
# BASE44_API_KEY=
