{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": "nextjs",
  "buildCommand": "node scripts/generate-next-page-registry.mjs && node scripts/write-p38-build-info.mjs && next build",
  "installCommand": "npm ci",
  "ignoreCommand": "bash scripts/vercel-ignore-git-build.sh",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
