{
  "name": "p38-catalogo-b2b",
  "private": false,
  "version": "1.0.0",
  "description": "Catálogo B2B white-label — gerador HTML estático + deploy Vercel (P38 sistemas)",
  "type": "module",
  "scripts": {
    "catalogo:snapshot-formigres": "node scripts/catalogo/snapshot-formigres.mjs",
    "catalogo:snapshot-cerbras": "node scripts/catalogo/snapshot-cerbras.mjs",
    "catalogo:snapshot-arielle": "node scripts/catalogo/snapshot-arielle.mjs",
    "catalogo:match": "node scripts/catalogo/match-local.mjs",
    "catalogo:classificar-tintao": "node scripts/catalogo/classificar-tintao-formigres.mjs",
    "catalogo:classificar-formigres": "node scripts/catalogo/classificar-formigres-completo.mjs",
    "catalogo:classificar-arielle": "node scripts/catalogo/classificar-arielle-completo.mjs",
    "catalogo:html-tintao": "node scripts/catalogo/gerar-html-tintao-catalogo.mjs",
    "catalogo:html-formigres": "node scripts/catalogo/gerar-html-formigres-catalogo.mjs",
    "catalogo:html-arielle": "node scripts/catalogo/gerar-html-arielle-catalogo.mjs",
    "catalogo:test-arielle-embalagem": "node scripts/catalogo/test-catalogo-arielle-embalagem.mjs",
    "catalogo:fetch-arielle-logo": "node scripts/catalogo/fetch-arielle-logo.mjs",
    "catalogo:publicar-tintao": "node scripts/catalogo/gerar-html-tintao-catalogo.mjs",
    "catalogo:publicar-formigres": "node scripts/catalogo/classificar-formigres-completo.mjs && node scripts/catalogo/gerar-html-formigres-catalogo.mjs",
    "catalogo:publicar-arielle": "node scripts/catalogo/snapshot-arielle.mjs && node scripts/catalogo/classificar-arielle-completo.mjs && node scripts/catalogo/gerar-html-arielle-catalogo.mjs",
    "catalogo:snapshot-ecuaceramica": "node scripts/catalogo/snapshot-ecuaceramica.mjs",
    "catalogo:classificar-ecuaceramica": "node scripts/catalogo/classificar-ecuaceramica-completo.mjs",
    "catalogo:html-ecuaceramica": "node scripts/catalogo/gerar-html-ecuaceramica-catalogo.mjs",
    "catalogo:fetch-ecuaceramica-logo": "node scripts/catalogo/fetch-ecuaceramica-logo.mjs",
    "catalogo:publicar-ecuaceramica": "node scripts/catalogo/fetch-ecuaceramica-logo.mjs && node scripts/catalogo/snapshot-ecuaceramica.mjs && node scripts/catalogo/classificar-ecuaceramica-completo.mjs && node scripts/catalogo/gerar-html-ecuaceramica-catalogo.mjs",
    "catalogo:test-ecuaceramica-embalagem": "node scripts/catalogo/test-catalogo-ecuaceramica-embalagem.mjs",
    "catalogo:test-ecuaceramica-precos": "node scripts/catalogo/test-catalogo-ecuaceramica-precos.mjs",
    "catalogo:test-ecuaceramica-pei": "node scripts/catalogo/test-catalogo-ecuaceramica-pei.mjs",
    "catalogo:test-tour": "node scripts/catalogo/test-catalogo-tour.mjs",
    "catalogo:test-suframa": "node scripts/catalogo/test-catalogo-suframa.mjs",
    "repo:publicar": "bash scripts/publicar-github-repo.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
